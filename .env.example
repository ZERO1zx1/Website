# Copy to .env locally. Never commit the populated .env file.
FLASK_ENV=development
FLASK_DEBUG=false
FRONTEND_ONLY=false
HOST=0.0.0.0
PORT=5000
SECRET_KEY=replace-with-a-long-random-secret
SUPABASE_URL=https://your-project.supabase.co
# Supabase is database/storage only; CodeCraft Auth does not use Supabase Auth.
SUPABASE_KEY=replace-with-supabase-publishable-key
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
# Server-only database key. Never copy this value to browser code, Docker build args, or logs.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Gmail SMTP: use a Gmail App Password, never your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM=CodeCraft Academy <your-sender@gmail.com>

# CodeCraft direct Google OAuth is optional and separate from Gmail SMTP security codes.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# Public browser URL used after CodeCraft app-auth redirects.
FRONTEND_URL=http://localhost:5000
# Direct Google OAuth callback target; register the same URL in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5000/api/auth/google/callback
# Internal sandbox service used by the submission evaluator.
SANDBOX_URL=http://localhost:8080
SANDBOX_TOKEN=replace-with-a-long-random-sandbox-token
SANDBOX_REQUIRED=true
SUBMISSION_WORKERS=2
SUBMISSION_QUEUE_MODE=thread
REDIS_URL=redis://localhost:6379/0
MAX_CONTENT_LENGTH=262144
