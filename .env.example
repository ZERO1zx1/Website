# Copy to .env locally. Never commit the populated .env file.
FLASK_ENV=development
FLASK_DEBUG=false
FRONTEND_ONLY=false
HOST=0.0.0.0
PORT=5000
SECRET_KEY=replace-with-a-long-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-supabase-key
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# Public browser URL used after Supabase Auth redirects.
FRONTEND_URL=http://localhost:5000
# Supabase Auth email OTP redirect target.
OTP_REDIRECT_URL=http://localhost:5000/
# Add this URL to Supabase Auth > URL Configuration > Redirect URLs.
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5000/api/auth/google/callback
# Internal sandbox service used by the submission evaluator.
SANDBOX_URL=http://localhost:8080
SANDBOX_TOKEN=replace-with-a-long-random-sandbox-token
SUBMISSION_WORKERS=2
SUBMISSION_QUEUE_MODE=thread
REDIS_URL=redis://localhost:6379/0
MAX_CONTENT_LENGTH=262144
